<?xml version="1.0" encoding="utf-8"?>
<!-- Selector for the play/pause MaterialButton: shows pause while pressed
     (long-press feedback before the shutdown dialog opens) and play otherwise;
     the running/paused state icon is swapped programmatically as well. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/ic_pause" />
    <item android:drawable="@drawable/ic_play" />
</selector>
