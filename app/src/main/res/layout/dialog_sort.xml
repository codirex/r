<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupSorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/sortName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_name" />

            <RadioButton
                android:id="@+id/sortArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_artist" />

            <RadioButton
                android:id="@+id/sortAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_album" />

            <RadioButton
                android:id="@+id/sortDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_duration" />

            <RadioButton
                android:id="@+id/sortRecentlyAdded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_recent" />

            <RadioButton
                android:id="@+id/sortMostPlayed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_played" />

            <RadioButton
                android:id="@+id/sortYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_year" />

            <RadioButton
                android:id="@+id/sortTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_tracks" />

            <RadioButton
                android:id="@+id/sortRecentlyCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_created" />

        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDescending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sort_descending" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/confirm" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
